# API binds to loopback by default. External binds require KUROCHAN_API_TOKEN.
HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

KUROCHAN_API_TOKEN=
KUROCHAN_DB_PATH=data/kurochan.sqlite
KUROCHAN_WORKER_ENABLED=false # Set true only when the API process should also run a worker.
KUROCHAN_WORKSPACE_ROOT=data/workspaces
KUROCHAN_WORKER_CONCURRENCY=4 # Concurrent independent tasks per worker (1..32). Keep total provider concurrency in mind.
KUROCHAN_WORKER_LEASE_MS=120000 # Task lease and heartbeat window (1000..600000 ms).
KUROCHAN_WORKER_POLL_MS=1000 # Idle queue polling interval (100..30000 ms).
KUROCHAN_WORKER_MAX_TOOL_ROUNDS=6 # Maximum model/tool cycles per task (1..12).
# Optional for a standalone worker only; use a unique value per worker process.
# KUROCHAN_WORKER_ID=worker-1
KUROCHAN_PLANNER_MAX_CANDIDATES=96 # Ranked from the full pinned specialist catalog (16..1000).

# Optional isolated command execution via Docker. The image must exist locally.
# Network is disabled by default. Set bridge only if outbound network is intentionally permitted.
KUROCHAN_SANDBOX_ENABLED=false
KUROCHAN_SANDBOX_IMAGE=node:22-bookworm-slim
KUROCHAN_SANDBOX_NETWORK=none
KUROCHAN_SANDBOX_TIMEOUT_MS=30000
KUROCHAN_SANDBOX_MAX_OUTPUT_BYTES=40000
DOCKER_BINARY=docker
API_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info

# OmniRouter owns routing policy. These comma-separated provider orders are internal,
# not external providers. Only providers that are actually configured are considered.
OMNIROUTER_ROUTE_FAST=freellmapi,openrouter
OMNIROUTER_ROUTE_BALANCED=openrouter,freellmapi
OMNIROUTER_ROUTE_QUALITY=openrouter,freellmapi
OMNIROUTER_MAX_ATTEMPTS=2
OMNIROUTER_MAX_CONCURRENT=24
OMNIROUTER_FAILURE_THRESHOLD=3
OMNIROUTER_CIRCUIT_COOLDOWN_MS=30000

# Optional authenticated GitHub project integration.
# Prefer a fine-grained PAT scoped only to the repositories listed below.
# Checkout requires Contents: read. Pull requests also require Contents: write and Pull requests: write.
# Publishing is disabled by default and the agent must receive task-level approval first.
KUROCHAN_GITHUB_TOKEN=
KUROCHAN_GITHUB_ALLOWED_REPOSITORIES=
KUROCHAN_GITHUB_WRITE_ENABLED=false
KUROCHAN_GITHUB_MAX_FILES=500
KUROCHAN_GITHUB_MAX_FILE_BYTES=250000
KUROCHAN_GITHUB_MAX_TOTAL_BYTES=10000000

# Optional Model Context Protocol (MCP) integrations.
# Use only MCP servers you trust. Configuration is admin-owned JSON and never model-controlled.
# Commands execute with the worker's OS permissions. Credentials are mapped from existing environment variables.
# See docs/MCP_TOOLS_SETUP.md for stdio and HTTPS Streamable HTTP examples.
KUROCHAN_MCP_SERVERS=[]

# Optional OpenAI-compatible speech-to-text (STT) and text-to-speech (TTS).
# A local open-source server may use loopback HTTP; remote endpoints must use HTTPS.
# STT defaults to English. TTS voice and instructions depend on the selected provider/model.
KUROCHAN_STT_BASE_URL=
KUROCHAN_STT_API_KEY=
KUROCHAN_STT_MODEL=
KUROCHAN_STT_LANGUAGE=en
KUROCHAN_TTS_BASE_URL=
KUROCHAN_TTS_API_KEY=
KUROCHAN_TTS_MODEL=
KUROCHAN_TTS_VOICE=nova
KUROCHAN_TTS_FORMAT=mp3
KUROCHAN_TTS_INSTRUCTIONS=Speak English in a natural, warm feminine voice with a light Japanese accent.
KUROCHAN_SPEECH_MAX_AUDIO_BYTES=26214400
KUROCHAN_SPEECH_MAX_TEXT_CHARACTERS=20000
KUROCHAN_SPEECH_MAX_RESPONSE_BYTES=20971520

# Optional general web research via Brave Search LLM Context.
# Supply your own API key; general web research stays disabled without one.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNTRY=BD
BRAVE_SEARCH_LANG=en

# Optional upstream provider: OpenRouter.
# Capability flags are opt-in because support depends on the configured model.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_CAP_STREAMING=false
OPENROUTER_STREAM_USAGE=false # Enable only if the selected endpoint supports stream_options.include_usage.

# Optional local FreeLLMAPI router (https://github.com/tashfeenahmed/freellmapi).
# Add upstream provider keys in FreeLLMAPI, then copy its unified API key here.
# Defaults work when FreeLLMAPI is running on this same host at port 3001.
# If Kuro-chan runs in Docker, use the FreeLLMAPI service name on the shared network.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_CAP_STREAMING=true
FREELLMAPI_STREAM_USAGE=false # Enable only if your FreeLLMAPI upstream supports stream_options.include_usage.
