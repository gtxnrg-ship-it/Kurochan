# API binds to loopback by default. External binds require KUROCHAN_API_TOKEN.
HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

KUROCHAN_API_TOKEN=
KUROCHAN_DB_PATH=data/kurochan.sqlite
KUROCHAN_WORKER_ENABLED=false # Set true only when the API process should also run a worker.
KUROCHAN_WORKSPACE_ROOT=data/workspaces
KUROCHAN_PLANNER_MAX_CANDIDATES=96 # Ranked from the full pinned specialist catalog (16..1000).

# Optional isolated command execution via Docker. The image must exist locally.
# Network is disabled by default. Set bridge only if outbound network is intentionally permitted.
KUROCHAN_SANDBOX_ENABLED=false
KUROCHAN_SANDBOX_IMAGE=node:22-bookworm-slim
KUROCHAN_SANDBOX_NETWORK=none
KUROCHAN_SANDBOX_TIMEOUT_MS=30000
KUROCHAN_SANDBOX_MAX_OUTPUT_BYTES=40000
DOCKER_BINARY=docker
API_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info

# OmniRouter owns routing policy. These comma-separated provider orders are internal,
# not external providers. Only providers that are actually configured are considered.
OMNIROUTER_ROUTE_FAST=freellmapi,openrouter
OMNIROUTER_ROUTE_BALANCED=openrouter,freellmapi
OMNIROUTER_ROUTE_QUALITY=openrouter,freellmapi
OMNIROUTER_MAX_ATTEMPTS=2
OMNIROUTER_MAX_CONCURRENT=24
OMNIROUTER_FAILURE_THRESHOLD=3
OMNIROUTER_CIRCUIT_COOLDOWN_MS=30000

# Optional upstream provider: OpenRouter.
# Capability flags are opt-in because support depends on the configured model.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_CAP_STREAMING=false

# Optional local FreeLLMAPI router (https://github.com/tashfeenahmed/freellmapi).
# Add upstream provider keys in FreeLLMAPI, then copy its unified API key here.
# Defaults work when FreeLLMAPI is running on this same host at port 3001.
# If Kuro-chan runs in Docker, use the FreeLLMAPI service name on the shared network.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_CAP_STREAMING=true
