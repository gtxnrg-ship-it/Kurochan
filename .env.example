# Server binds to loopback by default. Set HOST explicitly for a remote deployment.
HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173

# OpenRouter: credentials stay in the server environment.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# FreeLLMAPI: point at your own trusted FreeLLMAPI instance or another OpenAI-compatible
# gateway. Example local URL only; change it to match your own deployment.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=

# Optional client override for deployments where the API is not same-origin.
VITE_API_BASE_URL=
